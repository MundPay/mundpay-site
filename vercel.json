{
  "rewrites": [
    {
      "source": "/marketplace",
      "destination": "https://orders.mundpay.com/marketplace"
    },
    {
      "source": "/marketplace/:path*",
      "destination": "https://orders.mundpay.com/marketplace/:path*"
    },
    {
      "source": "/api/marketplace/:path*",
      "destination": "https://orders.mundpay.com/api/marketplace/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://orders.mundpay.com/_next/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}