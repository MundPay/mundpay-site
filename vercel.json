{
  "rewrites": [
    {
      "source": "/marketplace",
      "destination": "https://area-do-cliente-mundpay.vercel.app/marketplace"
    },
    {
      "source": "/marketplace/:path*",
      "destination": "https://area-do-cliente-mundpay.vercel.app/marketplace/:path*"
    },
    {
      "source": "/api/marketplace/:path*",
      "destination": "https://area-do-cliente-mundpay.vercel.app/api/marketplace/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://area-do-cliente-mundpay.vercel.app/_next/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}